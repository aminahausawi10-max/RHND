{
    "cleanUrls": true,
    "functions": {
        "api/**/*.php": {
            "runtime": "vercel-php@0.6.2"
        }
    },
    "rewrites": [
        { "source": "/admin", "destination": "/public/admin.html" },
        { "source": "/news", "destination": "/public/news.html" },
        { "source": "/login", "destination": "/public/login.html" },
        { "source": "/register", "destination": "/public/register.html" },
        { "source": "/dashboard", "destination": "/public/member-dashboard.html" },
        { "source": "/membership", "destination": "/public/membership.html" },
        { "source": "/members", "destination": "/public/membership.html" },
        { "source": "/support", "destination": "/public/support.html" },
        { "source": "/agencies", "destination": "/public/agencies.html" },
        { "source": "/ministries", "destination": "/public/ministries.html" },
        { "source": "/national-assembly", "destination": "/public/national-assembly.html" },
        { "source": "/diaspora", "destination": "/public/diaspora.html" },
        { "source": "/government", "destination": "/public/government.html" },
        { "source": "/media", "destination": "/public/media.html" },
        { "source": "/api/(.*)", "destination": "/api/index.php" },
        { "source": "/", "destination": "/public/index.html" }
    ]
}

