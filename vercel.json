{
    "cleanUrls": true,
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.6.2"
        },
        "api/**/*.php": {
            "runtime": "vercel-php@0.6.2"
        }
    },
    "headers": [
        {
            "source": "/admin",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Expires", "value": "0" }
            ]
        },
        {
            "source": "/public/admin-v2.html",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
                { "key": "Pragma", "value": "no-cache" },
                { "key": "Expires", "value": "0" }
            ]
        }
    ],
    "rewrites": [
        { "source": "/admin", "destination": "/public/admin-v2.html" },
        { "source": "/login", "destination": "/public/login.html" },
        { "source": "/register", "destination": "/public/register.html" },
        { "source": "/dashboard", "destination": "/public/member-dashboard.html" },
        { "source": "/membership", "destination": "/public/membership.html" },
        { "source": "/members", "destination": "/public/membership.html" },
        { "source": "/news", "destination": "/public/news.html" },
        { "source": "/support", "destination": "/public/support.html" },
        { "source": "/css/(.*)", "destination": "/public/css/$1" },
        { "source": "/js/(.*)", "destination": "/public/js/$1" },
        { "source": "/(.*\\.html)", "destination": "/public/$1" },
        { "source": "/", "destination": "/public/index.html" }
    ]
}
